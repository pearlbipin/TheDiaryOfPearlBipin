{
  "buildCommand": "node scripts/build.js",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/entry/:id", "destination": "/entry.html" }
  ],
  "headers": [
    {
      "source": "/data/entries.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ]
}
